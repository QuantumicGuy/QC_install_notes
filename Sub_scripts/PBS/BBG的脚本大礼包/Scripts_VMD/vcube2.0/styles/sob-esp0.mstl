# complex red-white-blue for simple molecule
proc ::vcube::Vapply_style {m_name} {
	# set tachyon options
    variable tachyon_options
    variable map_scale_value
	variable color_scale
	set tachyon_options ""
	#set tachyon_options "-trans_raster3d "
	set tachyon_options "-shadow_filter_off"
	
	#set direct light and ambient light
	light 0 on
	light 1 on
	light 2 on
	light 3 on
	display shadows off
    display ambientocclusion off
	display aoambient 0.8
	display aodirect 0.3
	
    # basis settings
    color Display Background white
    axes location Off
    display depthcue off
    display projection Orthographic
    display rendermode GLSL

    # surface materials a
    if {[lsearch [material list] ${m_name}a] < 0} {material add ${m_name}a}
    set mprop  {ambient diffuse specular shininess mirror opacity outline outlinewidth transmode}
    set mvalue {0.0     0.66     0.5     0.75       0.0    0.62     0.4     0.94          1.0}
    foreach mp $mprop mv $mvalue {material change $mp ${m_name}a $mv} 
    mol modmaterial 1 top ${m_name}a

    # surface color
	mol modcolor 1 top Volume 1
	color scale method $color_scale
	mol scaleminmax top 1 {*}$map_scale_value
	# color scale colors BWR 28 29 30
	# color change rgb 28
	# color change rgb 29
	# color change rgb 30
	
      # atom materials
    if {[lsearch [material list] vcubeatom] < 0} {material add vcubeatom}
    mol modstyle 0 top CPK 0.700000 0.400000 30.000000 30.000000
    mol modmaterial 0 top vcubeatom
    set mprop  {ambient diffuse specular shininess mirror opacity outline outlinewidth transmode}
    set mvalue {0.0     0.65     0.5      0.53       0.0    0.99     0.0     0.0          0.0}
    foreach mp $mprop mv $mvalue {material change $mp vcubeatom $mv} 

    # atom color
    mol modcolor 0 top Element
    color Element C cyan
    color Element H white
    color Element S yellow
    color change rgb 4  1.000000 0.800000 0.000000
    color Element F yellow2
    color change rgb 17  0.800000 1.000000 0.000000
    color Element Cl yellow3
    color change rgb 18  0.500000 1.000000 0.000000
    color Element Br magenta2
    color change rgb 28  0.900000 0.100000 0.000000
    color Element I magenta
    color change rgb 27  0.700000 0.000000 0.700000
    color Element B pink
    color change rgb 9   1.000000 0.400000 0.800000
    color Element P red2
    color change rgb 29   1.000000 0.400000 0.000000 



	
}