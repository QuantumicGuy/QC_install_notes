#!/bin/sh
#PBS -N Gaussian
#PBS -o job.log
#PBS -e err.log
#PBS -q yuan
#PBS -l nodes=1:ppn=4
#PBS -l walltime=1440:00:00
#PBS -j oe

mkdir -p /tmp/$PBS_JOBID
cp -r $PBS_O_WORKDIR/* /tmp/$PBS_JOBID
cd /tmp/$PBS_JOBID

g09 anion.com &
wait
g09 cation.com &
wait
g09 neutral.com &
wait


cp -r /tmp/$PBS_JOBID/*  $PBS_O_WORKDIR
rm -rf /tmp/$PBS_JOBID



