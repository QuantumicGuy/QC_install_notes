#This script is used to draw isosurface map of cube files generated by Multiwfn
#Written by Tian Lu (sobereva@sina.com), 2019-May-18

proc elf {filename {isoval 0.05}} {
#default material
set mater Glossy

color Display Background white
display depthcue off
display rendermode GLSL
axes location Off
color change rgb tan 0.700000 0.560000 0.360000
material change outline Opaque 4.000000
material change outlinewidth Opaque 0.5
material change ambient Glossy 0.1
material change diffuse Glossy 0.600000
material change specular Glossy 0.50
material change shininess Glossy 1.00
material change mirror Glossy 0
material change opacity Glossy 0.95
material change outline Glossy 0.20
material change outlinewidth Glossy 0
mol default color Element

foreach i [molinfo list] {
mol delete $i
}

mol new $filename.cub
mol modstyle 0 top CPK 0.800000 0.300000 22.000000 22.000000
mol addrep top
mol modstyle 1 top Isosurface $isoval 0 0 0 1 1
mol modcolor 1 top ColorID 27
mol modmaterial 1 top $mater
mol addrep top
mol modstyle 2 top Isosurface -$isoval 0 0 0 1 1
mol modcolor 2 top ColorID 27
mol modmaterial 2 top $mater
display distance -8.0
display height 10
}

proc elfiso {isoval} {
mol modstyle 1 top Isosurface $isoval 0 0 0 1 1
mol modstyle 2 top Isosurface -$isoval 0 0 0 1 1
}

proc elf2 {filename1 filename2 {isoval 0.05}} {
#default material
set mater Glossy

color Display Background white
display depthcue off
display rendermode GLSL
axes location Off
color Name C tan
color change rgb tan 0.700000 0.560000 0.360000
material change outline Opaque 4.000000
material change outlinewidth Opaque 0.5
material change ambient Glossy 0.1
material change diffuse Glossy 0.600000
material change specular Glossy 0.50
material change shininess Glossy 1.00
material change mirror Glossy 0
material change opacity Glossy 0.95
material change outline Glossy 0.20
material change outlinewidth Glossy 0
light 3 on

foreach i [molinfo list] {
mol delete $i
}

mol new $filename1.cub
mol modstyle 0 top CPK 0.800000 0.300000 22.000000 22.000000
mol addrep top
mol modstyle 1 top Isosurface $isoval 0 0 0 1 1
mol modcolor 1 top ColorID 27
mol modmaterial 1 top $mater

mol new $filename2.cub
mol modstyle 0 top CPK 0.800000 0.300000 22.000000 22.000000
mol addrep top
mol modstyle 1 top Isosurface $isoval 0 0 0 1 1
mol modcolor 1 top ColorID 27
mol modmaterial 1 top $mater

display distance -8.0
display height 10
}

proc elf2iso {isoval} {
foreach i [molinfo list] {
mol modstyle 1 $i Isosurface $isoval 0 0 0 1 1
}
}